# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: Supabase project URL (found in project settings -> API)
# SUPABASE_ANON_KEY: Supabase public/anonymous API key (found in project settings -> API)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# GOOGLE_WEB_CLIENT_ID: The Google Cloud OAuth *Web* client ID (never the Android one).
# Credential Manager passes this to Google so the ID token is issued for Supabase Auth.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
