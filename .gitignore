--- .gitignore
# Gradle files
.gradle/
build/
**/build/

# Kotlin compiler files
.kotlin/

# IDE settings (Android Studio / IntelliJ)
.idea/
*.iml
*.ipr
*.iws
out/

# Local configurations & secrets
local.properties
.env

# Keystores & signing keys
*.keystore
*.jks
!debug.keystore

# OS generated files
.DS_Store
Thumbs.db

# text file for temporary notes
ongoing_fixes.txt

#Freebuff files
.freebuff/
/.freebuff

# Release build outputs
app/release/
/app/release
